     <!-- Open wooden collection bin beside ClutteringC_01_031.
          Outer footprint: 1.0 x 1.0 m; inner footprint: 0.9 x 0.9 m. -->
     <model name="wooden_collection_bin_cluttering_c_031">
       <static>true</static>
       <pose>0 2.301994 0 0 0 0</pose>
       <link name="bin">
         <collision name="bottom_collision">
           <pose>0 0 0.025 0 0 0</pose>
           <geometry><box><size>1.0 1.0 0.05</size></box></geometry>
