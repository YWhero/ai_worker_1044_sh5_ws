########################################
# Internal Main <-> Engine process commands
########################################
# Hosted by the policy container's Engine process at /<backend>/engine_command.
# External clients should keep using /<backend>/inference_command.

uint8 LOAD_POLICY   = 0
uint8 GET_ACTION    = 1
uint8 UNLOAD_POLICY = 2
# Start a new logical episode without reloading model weights. The Engine
# resets stateful policy/preprocessor/action-overlap state, reconnects sensor
# inputs, and recalibrates episode-scoped tactile baselines.
uint8 RESET_POLICY  = 3
# Backend opt-in: replace weights without reconnecting/calibrating sensors.
uint8 SWITCH_POLICY = 4
uint8 PRELOAD_POLICY = 5
uint8 CLEAR_PRELOAD = 6
uint8 SWITCH_PRELOADED = 7

uint8 command

# Monotonic request id generated by Main. Engine echoes it back so Main can
# discard late/stale responses after a configurable timeout.
uint64 seq_id

# LOAD_POLICY fields.
string model_path
string embodiment_tag
string robot_type
string task_instruction
string acceleration_mode
string acceleration_engine_path
---
uint64 seq_id
bool success
string message

# LOAD_POLICY response.
string[] action_keys

# GET_ACTION response. action_list is row-major:
# chunk_size * action_dim == len(action_list).
int32 chunk_size
int32 action_dim
float64[] action_list
