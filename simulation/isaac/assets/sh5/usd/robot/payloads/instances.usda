    def Xform "base_mobile_assy" (
        prepend references = @./geometries.usd@</Geometries/base_mobile_assy>
    )
    {
        over "base_mobile_assy" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/base_mobile_assy/VisualMaterials/silver>
        }

        def Scope "VisualMaterials"
        {
            def Material "silver" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/silver>
            )
            {
            }
        }
    }

    def Xform "base_mobile_assy_1" (
        prepend references = @./geometries.usd@</Geometries/base_mobile_assy>
    )
    {
        over "base_mobile_assy" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            token purpose = "guide"
        }
    }

