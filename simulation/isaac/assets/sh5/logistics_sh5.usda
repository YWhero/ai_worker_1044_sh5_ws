#usda 1.0
(
    customLayerData = {
        string description = "SH5/HX5 floating-base PhysX overlay; original logistics cell read-only"
    }
    defaultPrim = "World"
    endTimeCode = 36000
    framesPerSecond = 60
    metersPerUnit = 1
    startTimeCode = 0
